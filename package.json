{
  "name": "autoschub",
  "version": "0.1.0",
  "private": true,
  "description": "AutoSchub — le Uber de l'auto-école en Belgique : réserve ton moniteur, passe ta théorie.",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client && node scripts/copy-dist.mjs",
    "start": "npm run start --workspace server",
    "seed": "npm run seed --workspace server",
    "test": "npm test --workspace server"
  },
  "engines": {
    "node": "22.x"
  },
  "type": "module",
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
